# Connection string for your existing MongoDB deployment (server-only; never exposed to the browser).
MONGODB_URI="mongodb://localhost:27017"
# Database used by this app inside that deployment.
MONGODB_DB="auto_invoice"

# App login. Required in production unless ALLOW_UNAUTHENTICATED=true.
# Generate AUTH_PASSWORD_HASH and AUTH_SECRET with: npm run auth:hash-password
AUTH_USERNAME=""
AUTH_PASSWORD_HASH=""
AUTH_SECRET=""
ALLOW_UNAUTHENTICATED="false"

# Optional: use an existing Chrome/Chromium instead of the one Puppeteer downloads.
PUPPETEER_EXECUTABLE_PATH=""

# Maximum concurrent PDF renders per server process.
PDF_MAX_CONCURRENCY="2"

# Optional: send PDF rendering to the standalone service (services/pdf-server.ts, deployed on Render).
# Leave empty to render with local Chrome (development, or a single-server deployment).
PDF_SERVICE_URL=""
PDF_SERVICE_TOKEN=""
